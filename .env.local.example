# ─────────────────────────────────────────────────────────────────────────────
# Elite Turf — Variables d'environnement (template)
#
# Copie ce fichier en .env.local et remplis avec tes vraies valeurs.
# .env.local est dans .gitignore — il ne doit JAMAIS être commit.
#
# ⚠️  Ce fichier (.env.local.example) ne doit contenir que des PLACEHOLDERS.
# Si tu colles ici une vraie clé, le pre-commit hook gitleaks va te bloquer
# et il faudra rotater la clé immédiatement (Supabase / Stripe / Paystack).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-or-anon-key>
# ⚠️  service_role bypass les RLS. À ne JAMAIS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# CinetPay (mobile money Côte d'Ivoire) — désactivé tant que SASU non immatriculée
CINETPAY_API_KEY=<your-cinetpay-api-key>
CINETPAY_SITE_ID=<your-cinetpay-site-id>

# Paystack (mobile money + carte — accepte sociétés en cours d'immatriculation)
PAYSTACK_PUBLIC_KEY=<pk_live_or_pk_test_...>
PAYSTACK_SECRET_KEY=<sk_live_or_sk_test_...>

# Stripe (carte Europe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_or_pk_test_...>
STRIPE_SECRET_KEY=<sk_live_or_sk_test_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>

# Resend (emails transactionnels)
RESEND_API_KEY=<re_...>

# OneSignal (notifications push)
NEXT_PUBLIC_ONESIGNAL_APP_ID=<your-onesignal-app-id>
ONESIGNAL_REST_API_KEY=<your-onesignal-rest-api-key>

# Twilio (SMS de bienvenue + alertes) — feature OFF tant que ces clés sont absentes.
# Console Twilio → Account Info. Utiliser de préférence un Messaging Service
# (gère expéditeurs/STOP/retries) ; sinon un numéro TWILIO_PHONE_NUMBER en E.164.
TWILIO_ACCOUNT_SID=<ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_MESSAGING_SERVICE_SID=<MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx   # alternative au Messaging Service

# App
NEXT_PUBLIC_APP_URL=https://www.elite-turf.fr
NEXT_PUBLIC_APP_NAME=Elite Turf
NEXT_PUBLIC_WHATSAPP=+33644686720

# Cron security — générer avec : openssl rand -hex 32
# Même valeur à mettre dans Vercel + Cloudflare Workers env vars
CRON_SECRET=<random-hex-32-chars>

# Sentry (à venir — voir audit/01-architecture.md)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
